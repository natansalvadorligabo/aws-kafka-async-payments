<?xml version="1.0" encoding="UTF-8"?>
<!-- ECS JSON, the same format the Spring Boot services log in. -->
<Configuration>
    <Appenders>
        <Console name="stdout">
            <JsonTemplateLayout eventTemplateUri="classpath:EcsLayout.json"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="stdout"/>
        </Root>
    </Loggers>
</Configuration>
